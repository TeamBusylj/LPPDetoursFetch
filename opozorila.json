      "contentHtml": "\n\n                            <div class=\"content--wrapper\">\n\n                                \n\n                                <div class=\"content--top\">\n                                   \n                                  \n  <div class=\"field field-name-body field-type-text-with-summary field-label-hidden\">\n    <p data-end=\"122\" data-start=\"103\">Spoštovani potniki,</p>\n\n<p data-end=\"233\" data-start=\"124\">obveščamo vas, da bo zaradi popolne prometne zapore Čerinove ulice linija 14 obratovala po spremenjeni trasi.</p>\n\n<p data-end=\"356\" data-start=\"235\">Sprememba velja od petka, 17. 4. 2026 (po prometni konici), do predvidoma 18. 4. 2026 oziroma do zaključka gradbenih del.</p>\n\n<p data-end=\"447\" data-start=\"358\"><strong data-end=\"376\" data-start=\"358\">Obvozna trasa:</strong><br data-end=\"379\" data-start=\"376\">\n\tUlica 7. septembra, Dunajska cesta, Ježica in enako v obratni smeri.</p>\n\n<p data-end=\"447\" data-start=\"358\"><img alt=\"\" src=\"https://raw.githubusercontent.com/TeamBusylj/LPPDetoursFetch/main/slike/990c9a15c015d3e2a7ad3bfefc434219.png\"></p>\n\n<p data-end=\"447\" data-start=\"358\">Hvala za razumevanje.</p>\n  </div>\n    \n                                    \n                                </div>\n                                \n                                <div class=\"content--bottom\">\n                                \n                                \n                                </div>\n\n                               \n                                \n                                <div id=\"content__share\">\n                                    \n                                    \n                                    \n                                </div>\n\n                            </div>\n\n                        "
