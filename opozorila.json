      "contentHtml": "\n\n                            <div class=\"content--wrapper\">\n\n                                \n\n                                <div class=\"content--top\">\n                                   \n                                  \n  <div class=\"field field-name-body field-type-text-with-summary field-label-hidden\">\n    <p data-end=\"125\" data-start=\"106\">Spoštovani potniki,</p>\n\n<p data-end=\"347\" data-start=\"127\">zaradi popolne prometne zapore na delu ceste <strong data-end=\"204\" data-start=\"172\">Ljubljana – Šentvid – Vodice</strong> v naselju <strong data-end=\"227\" data-start=\"215\">Skaručna</strong> bo od <strong data-end=\"284\" data-start=\"234\">srede, 28. 1. 2026, do zaključka gradbenih del</strong> avtobusna linija <strong data-end=\"308\" data-start=\"302\">60</strong> vozila po spremenjeni (obvozni) trasi.</p>\n\n<p data-end=\"497\" data-start=\"349\"><strong data-end=\"377\" data-start=\"349\">Obvozna trasa:</strong><br>\n\tPovodje – Vojsko – Polje pri Vodicah – začasno nadomestno postajališče Skaručna – redna trasa in enako v obratni smeri.</p>\n\n<p data-end=\"497\" data-start=\"349\"><img alt=\"\" src=\"https://raw.githubusercontent.com/TeamBusylj/LPPDetoursFetch/main/slike/5f6fc862d8f83b1881f3683f3b9fa992.png\"></p>\n\n<p data-end=\"571\" data-start=\"499\">Zaradi zapore je <strong data-end=\"570\" data-start=\"516\">postajališče Skaručna začasno ukinjeno v obe smeri</strong>.</p>\n\n<p data-end=\"608\" data-is-last-node=\"\" data-is-only-node=\"\" data-start=\"573\">Zahvaljujemo se vam za razumevanje.</p>\n  </div>\n    \n                                    \n                                </div>\n                                \n                                <div class=\"content--bottom\">\n                                \n                                \n                                </div>\n\n                               \n                                \n                                <div id=\"content__share\">\n                                    \n                                    \n                                    \n                                </div>\n\n                            </div>\n\n                        "
